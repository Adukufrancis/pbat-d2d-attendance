# Copy to .env for local development. Nothing is required locally (admin password is "admin").
PORT=3000
APP_NAME=PBAT D2D Office Attendance
# Organiser login password (set a strong one in production)
ADMIN_PASSWORD=
# Long random text. Signs the daily QR codes and the login. Keep it the same, or today's code changes.
SECRET=
# Postgres connection string (Neon). Leave empty locally to use a SQLite file.
DATABASE_URL=
# The day (and the QR code) changes at midnight in this time zone.
TIMEZONE=Africa/Lagos
# Only if your host doesn't put the visitor's address in CF-Connecting-IP (Render does):
# CLIENT_IP_HEADER=
CHECKOUT_TIME=17:00
